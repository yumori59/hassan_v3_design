#!/usr/bin/env bash
# pre-commit hook (frontend リポジトリ雛形) — 型チェック + 差分テスト を強制
#
# `ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit` で導入する。
# 二層化: 重い全体テスト・build・lint は CI、軽い「差分のみ」は pre-commit。
# 失敗するとコミット不可。`--no-verify` での回避はユーザー明示指示がない限り禁止。
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
ts_staged=$(echo "$staged" | grep -E '\.(ts|tsx)$' || true)

if [[ -z "$ts_staged" ]]; then
  echo "[pre-commit] TS 変更なし — スキップ"
  echo "[pre-commit] OK"
  exit 0
fi

if [[ ! -d node_modules ]]; then
  echo "[pre-commit] WARN: node_modules 未インストール — チェックをスキップ (npm ci 推奨)" >&2
  exit 0
fi

echo "[pre-commit] tsc --noEmit"
if ! npx tsc --noEmit; then
  echo "[pre-commit] FAIL: 型エラーを修正してから再コミットしてください" >&2
  exit 1
fi

# 差分に対応するテストのみ実行 (全体は CI)。テストランナーの --related 相当を使う。
echo "[pre-commit] 関連テスト"
# shellcheck disable=SC2086
if ! npx vitest related --run $ts_staged; then
  echo "[pre-commit] FAIL: テストが通りません" >&2
  exit 1
fi

# --- 生成型の追従漏れ検出 (非ブロック) ------------------------------------
# backend の OpenAPI から生成した型を手で編集していないか。
gen_staged=$(echo "$staged" | grep -E '^(src/)?(api|generated|lib/api)/.*\.(ts|tsx)$' || true)
if [[ -n "$gen_staged" ]]; then
  echo "[pre-commit] 注意: API 型の生成物と思われるファイルを変更しています:"
  echo "$gen_staged" | sed 's/^/[pre-commit]   /'
  echo "[pre-commit] 手編集ではなく backend の OpenAPI 更新 → 再生成で対応してください。"
fi

echo "[pre-commit] OK"
