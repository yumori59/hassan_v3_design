#!/usr/bin/env bash
# pre-commit hook (infra リポジトリ雛形) — terraform fmt / validate を強制
#
# `ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit` で導入する。
# plan は環境ごとの認証が要るため CI 側で実行する (pre-commit では走らせない)。
# 失敗するとコミット不可。`--no-verify` での回避はユーザー明示指示がない限り禁止。
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
tf_staged=$(echo "$staged" | grep -E '\.(tf|tfvars)$' || true)

# --- state / 秘密のコミット防止 (ブロック) -------------------------------
bad=$(echo "$staged" | grep -E '(\.tfstate(\.backup)?$|\.terraform/|\.tfvars$)' || true)
if [[ -n "$bad" ]]; then
  echo "[pre-commit] FAIL: コミットしてはいけないファイルが含まれています:" >&2
  echo "$bad" | sed 's/^/[pre-commit]   /' >&2
  echo "[pre-commit] .tfstate / .terraform/ は state と秘密情報を含みます。.gitignore に追加してください。" >&2
  echo "[pre-commit] .tfvars は環境固有値を含むため、コミットするなら秘密が入っていないことを確認してください。" >&2
  exit 1
fi

if [[ -z "$tf_staged" ]]; then
  echo "[pre-commit] Terraform 変更なし — スキップ"
  echo "[pre-commit] OK"
  exit 0
fi

if ! command -v terraform >/dev/null 2>&1; then
  echo "[pre-commit] WARN: terraform が見つかりません — チェックをスキップ" >&2
  exit 0
fi

echo "[pre-commit] terraform fmt -check -recursive"
if ! terraform fmt -check -recursive; then
  echo "[pre-commit] FAIL: terraform fmt -recursive を実行してから再コミットしてください" >&2
  exit 1
fi

# validate は init 済みディレクトリでのみ実行可能。init されていない環境はスキップする。
for d in $(echo "$tf_staged" | xargs -n1 dirname | sort -u); do
  if [[ -d "$d/.terraform" ]]; then
    echo "[pre-commit] terraform validate ($d)"
    if ! terraform -chdir="$d" validate; then
      echo "[pre-commit] FAIL: terraform validate ($d)" >&2
      exit 1
    fi
  else
    echo "[pre-commit] $d は init 未実行 — validate スキップ (CI で検証)"
  fi
done

# --- 危険な変更の注意喚起 (非ブロック) ------------------------------------
danger=$(git diff --cached -U0 -- '*.tf' | grep -E '^\+.*(0\.0\.0\.0/0|Action.*"\*"|Resource.*"\*"|skip_final_snapshot|deletion_protection\s*=\s*false)' || true)
if [[ -n "$danger" ]]; then
  echo "[pre-commit] 注意: 危険な可能性のある変更を検出しました。plan で影響を確認してください:"
  echo "$danger" | sed 's/^/[pre-commit]   /'
fi

echo "[pre-commit] OK"
